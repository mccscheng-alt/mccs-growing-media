{
  "site": {
    "name": "MCCS Growing Media",
    "baseUrl": "https://www.mccsgrowingmedia.com",
    "primaryEnglishPages": [
      "/",
      "/products/",
      "/sample-shipping/",
      "/private-label/",
      "/about/",
      "/contact/",
      "/insights/"
    ],
    "ignoredPages": [
      {
        "path": "/admin.html",
        "reason": "Internal product data manager page; not a public SEO landing page."
      }
    ],
    "protectedFiles": [
      "data/products.json",
      "vercel.json"
    ],
    "protectedPatterns": [
      "formspree.io",
      "G-GLM9JS10QN",
      "gtag/js?id=",
      "data/products.json"
    ]
  },
  "auditSettings": {
    "requestTimeoutMs": 20000,
    "maxPagesPerCompetitor": 8,
    "userAgent": "MCCS-Competitor-Audit/1.0 (+https://www.mccsgrowingmedia.com)"
  },
  "competitors": [
    {
      "name": "Jiffy Group",
      "baseUrl": "https://jiffygroup.com",
      "enabled": true,
      "pages": [
        "/products/"
      ],
      "ignoredPages": [
        {
          "path": "/products/jiffy-7/",
          "reason": "Returned 404 in first audit."
        }
      ]
    },
    {
      "name": "Grodan",
      "baseUrl": "https://www.grodan.com",
      "enabled": true,
      "pages": [
        "/",
        "/product-overview/"
      ]
    },
    {
      "name": "Riococo",
      "baseUrl": "https://www.riococo.com",
      "enabled": false,
      "disabledReason": "Fetch failed in first audit; keep listed for manual replacement before re-enabling.",
      "pages": [
        "/",
        "/products/"
      ]
    },
    {
      "name": "CANNA",
      "baseUrl": "https://www.canna.com",
      "enabled": true,
      "pages": [
        "/"
      ],
      "ignoredPages": [
        {
          "path": "/coco",
          "reason": "No useful page content was captured in first audit."
        }
      ]
    },
    {
      "name": "Legro",
      "baseUrl": "https://www.legrogroup.com",
      "enabled": true,
      "pages": [
        "/",
        "/products/"
      ]
    }
  ]
}
